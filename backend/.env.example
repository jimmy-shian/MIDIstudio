# 複製成 .env 後填寫。兩種二選一：本地代理（優先）或 OpenRouter。
# 沒填任何 KEY 時後端走規則式 fallback（離線可跑），照樣回傳 ops。

# --- 本地 OpenAI 相容端點（你的 WebChat 代理） ---
LLM_BASE_URL=http://127.0.0.1:8765/v1
LLM_API_KEY=sk-local
LLM_MODEL=webchat/auto
# 小模型建議：輸出上限 2048（4k 預算要留 thinking 空間），溫度 0.5 求穩
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.5

# --- OpenRouter（備用，不設 LLM_BASE_URL 時用這組） ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

PORT=3001
