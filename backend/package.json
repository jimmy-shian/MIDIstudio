{
  "name": "@midistudio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:build": "tsc && node dist/mcp/server.js",
    "mcp:bundle": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --outfile=dist/mcp-bundle/server.js --external:better-sqlite3 --log-level=warning"
  },
  "dependencies": {
    "@midistudio/shared": "0.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tonejs/midi": "^2.0.28",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "esbuild": "^0.28.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
